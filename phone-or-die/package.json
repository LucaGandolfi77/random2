{
  "name": "phone-or-die",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PHONE OR DIE — an original psychological horror survival game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
