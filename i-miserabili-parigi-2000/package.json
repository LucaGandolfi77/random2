{
  "name": "i-miserabili-parigi-2000",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "I Miserabili — Parigi 2000, cortometraggio animato 3D nel browser",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "predev": "npm run data",
    "dev": "vite",
    "prebuild": "npm run data",
    "build": "tsc --noEmit && vite build",
