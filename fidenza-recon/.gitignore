.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
web/dist/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
db/*.db
.DS_Store
db/*.db-*
