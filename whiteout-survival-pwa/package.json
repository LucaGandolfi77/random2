{
  "name": "whiteout-survival-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WHITEOUT: LAST EMBER — a mobile-first survival city builder inspired by Whiteout Survival.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "python3 tools/make_icons.py",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
