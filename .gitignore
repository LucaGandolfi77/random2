# Analysis output — regenerate with the tools
tools/balance/out/
tools/corpora/out/
tools/audit/out/
__pycache__/
*.pyc
.venv/

# Generated screenshots (regenerate with <app>/shot.mjs or <app>/smoke.mjs)
*/shots/
*/smoke-*.png

# ...except the portfolio's. That page is static and references them from
# index.html, so they are part of the site, not a review artefact. Regenerate
# with portfolio/scripts/shots.mjs.
!portfolio/shots/

# ...and the portfolio's self-audit. It is generated and committed, because a
# report nobody can read is the same as no report. Regenerate it with
# node tools/audit/run.mjs
!portfolio/audit/
