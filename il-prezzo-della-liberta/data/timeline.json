    {
      "id": "a4_confrontation_b005_line",
      "beatId": "a4_confrontation_b005",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "RENAUD",
      "text": "Sei tornato.",
      "emotion": "neutral",
      "start": 347.6,
      "end": 350
    },
    {
      "id": "a4_confrontation_b006_line",
      "beatId": "a4_confrontation_b006",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "ETIENNE",
      "text": "Pare di sì.",
      "emotion": "wry",
      "start": 350,
      "end": 352.2
    },
    {
      "id": "a4_confrontation_b007_line",
      "beatId": "a4_confrontation_b007",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "RENAUD",
      "text": "Ti avevo detto di non creare problemi.",
      "emotion": "angry",
      "start": 352.2,
      "end": 356.2
    },
    {
      "id": "a4_confrontation_b008_line",
      "beatId": "a4_confrontation_b008",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "ETIENNE",
      "text": "Non ne sto creando.",
      "emotion": "tired",
      "start": 356.2,
      "end": 359
    },
    {
      "id": "a4_confrontation_b009_line",
      "beatId": "a4_confrontation_b009",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "RENAUD",
      "text": "Che ci fai con la bambina?",
      "emotion": "angry",
      "start": 359,
      "end": 362.2
    },
    {
      "id": "a4_confrontation_b010_line",
      "beatId": "a4_confrontation_b010",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "ETIENNE",
      "text": "La accompagno da sua madre.",
      "emotion": "neutral",
      "start": 362.2,
      "end": 365.6
    },
    {
      "id": "a4_confrontation_b011_line",
      "beatId": "a4_confrontation_b011",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "RENAUD",
      "text": "Non ti credo.",
      "emotion": "angry",
      "start": 365.6,
      "end": 367.8
    },
    {
      "id": "a4_confrontation_b013_line",
      "beatId": "a4_confrontation_b013",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "MINA",
      "text": "Lui mi sta aiutando.",
      "emotion": "afraid",
      "start": 368.6,
      "end": 371.4
    },
    {
      "id": "a4_confrontation_b014_line",
      "beatId": "a4_confrontation_b014",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_renaud",
      "speaker": "RENAUD",
      "text": "Non parlare quando parlano gli adulti.",
      "emotion": "angry",
      "start": 371.4,
      "end": 375.8
    },
    {
      "id": "a4_confrontation_b016_line",
      "beatId": "a4_confrontation_b016",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "MINA",
      "text": "Allora gli adulti dovrebbero parlare meglio.",
      "emotion": "angry",
      "start": 376.8,
      "end": 381.6
    },
    {
      "id": "a4_confrontation_b018_line",
      "beatId": "a4_confrontation_b018",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_renaud",
      "speaker": "RENAUD",
      "text": "Devi venire con me.",
      "emotion": "neutral",
      "start": 383.8,
      "end": 387
    },
    {
      "id": "a4_confrontation_b019_line",
      "beatId": "a4_confrontation_b019",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_two",
      "speaker": "ETIENNE",
      "text": "Non posso.",
      "emotion": "tired",
      "start": 387,
      "end": 389
    },
    {
      "id": "a4_confrontation_b020_line",
      "beatId": "a4_confrontation_b020",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_renaud",
      "speaker": "RENAUD",
      "text": "Non puoi scegliere.",
      "emotion": "angry",
      "start": 389,
      "end": 391.6
    },
    {
      "id": "a4_confrontation_b021_line",
      "beatId": "a4_confrontation_b021",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_close_e",
      "speaker": "ETIENNE",
      "text": "È quello che mi avete ripetuto per nove anni.",
      "emotion": "angry",
      "start": 391.6,
      "end": 396.6
    },
    {
      "id": "a4_confrontation_b025_line",
      "beatId": "a4_confrontation_b025",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_low",
      "speaker": "MINA",
      "text": "Deve aiutarmi.",
      "emotion": "afraid",
      "start": 401.4,
      "end": 404
    },
    {
      "id": "a4_confrontation_b027_line",
      "beatId": "a4_confrontation_b027",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_renaud",
      "speaker": "RENAUD",
      "text": "Va'.",
      "emotion": "confused",
      "start": 407.2,
      "end": 408.8
    },
    {
      "id": "a4_confrontation_b029_line",
      "beatId": "a4_confrontation_b029",
      "actId": "act4",
      "sceneId": "a4_confrontation",
      "shot": "n_renaud",
      "speaker": "RENAUD",
      "text": "Ma non è finita.",
      "emotion": "neutral",
      "start": 409.9,
      "end": 412.7
    },
    {
      "id": "a4_metro_b003_line",
      "beatId": "a4_metro_b003",
      "actId": "act4",
      "sceneId": "a4_metro",
      "shot": "m_two",
      "speaker": "MINA",
      "text": "Lei ha paura di lui?",
      "emotion": "neutral",
      "start": 420,
      "end": 423.2
    },
    {
      "id": "a4_metro_b004_line",
      "beatId": "a4_metro_b004",
      "actId": "act4",
      "sceneId": "a4_metro",
      "shot": "m_two",
      "speaker": "ETIENNE",
      "text": "No.",
      "emotion": "neutral",
      "start": 423.2,
      "end": 425
    },
    {
      "id": "a4_metro_b005_line",
      "beatId": "a4_metro_b005",
      "actId": "act4",
      "sceneId": "a4_metro",
      "shot": "m_two",
      "speaker": "MINA",
      "text": "Mente.",
      "emotion": "wry",
      "start": 425,
      "end": 426.8
    },
    {
      "id": "a5_corridor_b003_line",
      "beatId": "a5_corridor_b003",
      "actId": "act5",
      "sceneId": "a5_corridor",
      "shot": "h_nurse",
      "speaker": "INFERMIERA",
      "text": "Reparto. Terzo piano.",
      "emotion": "neutral",
      "start": 438.8,
      "end": 441.8
    },
    {
      "id": "a5_corridor_b004_line",
      "beatId": "a5_corridor_b004",
      "actId": "act5",
      "sceneId": "a5_corridor",
      "shot": "h_nurse",
      "speaker": "ETIENNE",
      "text": "Grazie.",
      "emotion": "neutral",
      "start": 441.8,
      "end": 443.8
    },
    {
      "id": "a5_corridor_b006_line",
      "beatId": "a5_corridor_b006",
      "actId": "act5",
      "sceneId": "a5_corridor",
      "shot": "h_nurse",
      "speaker": "INFERMIERA",
      "text": "Le visite finiscono alle otto.",
      "emotion": "neutral",
      "start": 445.8,
      "end": 449.4
    },
    {
      "id": "a5_corridor_b010_line",
      "beatId": "a5_corridor_b010",
      "actId": "act5",
      "sceneId": "a5_corridor",
      "shot": "h_door",
      "speaker": "MINA",
      "text": "È qui.",
      "emotion": "afraid",
      "start": 457.4,
      "end": 459.4
    },
    {
      "id": "a5_corridor_b012_line",
      "beatId": "a5_corridor_b012",
      "actId": "act5",
      "sceneId": "a5_corridor",
      "shot": "h_door",
      "speaker": "ETIENNE",
      "text": "Vai.",
      "emotion": "tender",
      "start": 461.9,
      "end": 463.9
    },
    {
      "id": "a5_room_b003_line",
      "beatId": "a5_room_b003",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_wide",
      "speaker": "AICHA",
      "text": "Mina!",
      "emotion": "surprised",
      "start": 472.4,
      "end": 474.4
    },
    {
      "id": "a5_room_b004_line",
      "beatId": "a5_room_b004",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_wide",
      "speaker": "MINA",
      "text": "Mamma!",
      "emotion": "hopeful",
      "start": 474.4,
      "end": 476.4
    },
    {
      "id": "a5_room_b008_line",
      "beatId": "a5_room_b008",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_bed",
      "speaker": "AICHA",
      "text": "Grazie.",
      "emotion": "tender",
      "start": 481.3,
      "end": 483.7
    },
    {
      "id": "a5_room_b009_line",
      "beatId": "a5_room_b009",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_wide",
      "speaker": "ETIENNE",
      "text": "Non ho fatto niente.",
      "emotion": "tired",
      "start": 483.7,
      "end": 486.5
    },
    {
      "id": "a5_room_b010_line",
      "beatId": "a5_room_b010",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_bed",
      "speaker": "AICHA",
      "text": "Per lei ha fatto tutto.",
      "emotion": "tender",
      "start": 486.5,
      "end": 489.7
    },
    {
      "id": "a5_room_b015_line",
      "beatId": "a5_room_b015",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_hug",
      "speaker": "MINA",
      "text": "Grazie.",
      "emotion": "tender",
      "start": 496.3,
      "end": 498.5
    },
    {
      "id": "a5_room_b018_line",
      "beatId": "a5_room_b018",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_corridor",
      "speaker": "RENAUD",
      "text": "Moreau.",
      "emotion": "neutral",
      "start": 502.7,
      "end": 504.5
    },
    {
      "id": "a5_room_b019_line",
      "beatId": "a5_room_b019",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_corridor",
      "speaker": "ETIENNE",
      "text": "Lo so.",
      "emotion": "tired",
      "start": 504.5,
      "end": 506.3
    },
    {
      "id": "a5_room_b021_line",
      "beatId": "a5_room_b021",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_renaud",
      "speaker": "RENAUD",
      "text": "Non ti assolvo.",
      "emotion": "neutral",
      "start": 507.4,
      "end": 510
    },
    {
      "id": "a5_room_b022_line",
      "beatId": "a5_room_b022",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_renaud",
      "speaker": "ETIENNE",
      "text": "Non gliel'ho chiesto.",
      "emotion": "tired",
      "start": 510,
      "end": 513
    },
    {
      "id": "a5_room_b023_line",
      "beatId": "a5_room_b023",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_renaud",
      "speaker": "RENAUD",
      "text": "Il passato non si cancella.",
      "emotion": "neutral",
      "start": 513,
      "end": 516.4
    },
    {
      "id": "a5_room_b024_line",
      "beatId": "a5_room_b024",
      "actId": "act5",
      "sceneId": "a5_room",
      "shot": "r_renaud",
      "speaker": "ETIENNE",
      "text": "No. Ma il futuro non è ancora successo.",
      "emotion": "hopeful",
      "start": 516.4,
      "end": 521.4
    },
    {
      "id": "a6_laundrette_b004_line",
      "beatId": "a6_laundrette_b004",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_two",
      "speaker": "ROSE",
      "text": "Non hai un posto dove andare, vero?",
      "emotion": "tender",
      "start": 537.5,
      "end": 541.3
    },
    {
      "id": "a6_laundrette_b005_line",
      "beatId": "a6_laundrette_b005",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_bench",
      "speaker": "ETIENNE",
      "text": "No.",
      "emotion": "tired",
      "start": 541.3,
      "end": 542.9
    },
    {
      "id": "a6_laundrette_b006_line",
      "beatId": "a6_laundrette_b006",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_two",
      "speaker": "ROSE",
      "text": "Da me serve una mano in lavanderia.",
      "emotion": "neutral",
      "start": 542.9,
      "end": 546.5
    },
    {
      "id": "a6_laundrette_b007_line",
      "beatId": "a6_laundrette_b007",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_bench",
      "speaker": "ETIENNE",
      "text": "Non sono bravo a lavorare.",
      "emotion": "tired",
      "start": 546.5,
      "end": 549.7
    },
    {
      "id": "a6_laundrette_b008_line",
      "beatId": "a6_laundrette_b008",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_two",
      "speaker": "ROSE",
      "text": "Nessuno nasce bravo.",
      "emotion": "wry",
      "start": 549.7,
      "end": 552.5
    },
    {
      "id": "a6_laundrette_b009_line",
      "beatId": "a6_laundrette_b009",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_bench",
      "speaker": "ETIENNE",
      "text": "Ho dei precedenti.",
      "emotion": "sad",
      "start": 552.5,
      "end": 555.1
    },
    {
      "id": "a6_laundrette_b010_line",
      "beatId": "a6_laundrette_b010",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_two",
      "speaker": "ROSE",
      "text": "Anch'io. Una volta ho rubato una pianta.",
      "emotion": "wry",
      "start": 555.1,
      "end": 559.5
    },
    {
      "id": "a6_laundrette_b011_line",
      "beatId": "a6_laundrette_b011",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_bench",
      "speaker": "ETIENNE",
      "text": "Una pianta?",
      "emotion": "surprised",
      "start": 559.5,
      "end": 561.5
    },
    {
      "id": "a6_laundrette_b012_line",
      "beatId": "a6_laundrette_b012",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_two",
      "speaker": "ROSE",
      "text": "Era bellissima.",
      "emotion": "wry",
      "start": 561.5,
      "end": 563.9
    },
    {
      "id": "a6_laundrette_b015_line",
      "beatId": "a6_laundrette_b015",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_two",
      "speaker": "ROSE",
      "text": "Domani alle sette.",
      "emotion": "neutral",
      "start": 568.3,
      "end": 570.9
    },
    {
      "id": "a6_laundrette_b017_line",
      "beatId": "a6_laundrette_b017",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_close_e",
      "speaker": "ETIENNE",
      "text": "Perché mi aiuta?",
      "emotion": "confused",
      "start": 572.1,
      "end": 574.9
    },
    {
      "id": "a6_laundrette_b018_line",
      "beatId": "a6_laundrette_b018",
      "actId": "act6",
      "sceneId": "a6_laundrette",
      "shot": "l_two",
      "speaker": "ROSE",
      "text": "Perché qualcuno, una volta, ha aiutato me.",
      "emotion": "tender",
      "start": 574.9,
      "end": 579.7
    },
    {
      "id": "a6_dawn_b002_line",
      "beatId": "a6_dawn_b002",
      "actId": "act6",
      "sceneId": "a6_dawn",
      "shot": "d_walk",
      "speaker": "ETIENNE_VO",
      "text": "Non mi avevano restituito gli anni.",
      "emotion": "tired",
      "start": 586.9,
      "end": 591.1
    },
    {
      "id": "a6_dawn_b004_line",
      "beatId": "a6_dawn_b004",
      "actId": "act6",
      "sceneId": "a6_dawn",
      "shot": "d_walk",
      "speaker": "ETIENNE_VO",
      "text": "Non mi avevano restituito il nome.",
      "emotion": "tired",
      "start": 592.1,
      "end": 595.9
    },
    {
      "id": "a6_dawn_b006_line",
      "beatId": "a6_dawn_b006",
      "actId": "act6",
      "sceneId": "a6_dawn",
      "shot": "d_close",
      "speaker": "ETIENNE_VO",
      "text": "Non mi avevano restituito la vita.",
      "emotion": "sad",
      "start": 596.7,
      "end": 600.5
    },
    {
      "id": "a6_dawn_b008_line",
      "beatId": "a6_dawn_b008",
      "actId": "act6",
      "sceneId": "a6_dawn",
      "shot": "d_wide2",
      "speaker": "ETIENNE_VO",
      "text": "Ma qualcuno mi aveva lasciato una porta aperta.",
      "emotion": "hopeful",
      "start": 601.7,
      "end": 606.9
    }
