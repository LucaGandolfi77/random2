    {
      "id": "a1_prison_b007_line",
      "beatId": "a1_prison_b007",
      "actId": "act1",
      "sceneId": "a1_prison",
      "shot": "p_gate",
      "speaker": "GUARDIA",
      "text": "Non tornare.",
      "emotion": "neutral",
      "start": 21.6,
      "end": 24.4
    },
    {
      "id": "a1_prison_b008_line",
      "beatId": "a1_prison_b008",
      "actId": "act1",
      "sceneId": "a1_prison",
      "shot": "p_gate",
      "speaker": "ETIENNE",
      "text": "Non era nei miei programmi.",
      "emotion": "wry",
      "start": 24.4,
      "end": 28
    },
    {
      "id": "a1_prison_b012_line",
      "beatId": "a1_prison_b012",
      "actId": "act1",
      "sceneId": "a1_prison",
      "shot": "p_face",
      "speaker": "ETIENNE_VO",
      "text": "Pensavo che la libertà avesse un rumore.",
      "emotion": "tired",
      "start": 35.8,
      "end": 40.4
    },
    {
      "id": "a1_prison_b014_line",
      "beatId": "a1_prison_b014",
      "actId": "act1",
      "sceneId": "a1_prison",
      "shot": "p_face",
      "speaker": "ETIENNE_VO",
      "text": "Invece era silenziosa.",
      "emotion": "sad",
      "start": 41.6,
      "end": 44.6
    },
    {
      "id": "a1_prison_b016_line",
      "beatId": "a1_prison_b016",
      "actId": "act1",
      "sceneId": "a1_prison",
      "shot": "p_face",
      "speaker": "ETIENNE_VO",
      "text": "E non sapevo dove andare.",
      "emotion": "sad",
      "start": 45.6,
      "end": 49
    },
    {
      "id": "a2_bakery_b004_line",
      "beatId": "a2_bakery_b004",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "PROPRIETARIO",
      "text": "Hai esperienza?",
      "emotion": "neutral",
      "start": 87.5,
      "end": 90.5
    },
    {
      "id": "a2_bakery_b006_line",
      "beatId": "a2_bakery_b006",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "ETIENNE",
      "text": "Ho lavorato in fabbrica.",
      "emotion": "neutral",
      "start": 91.3,
      "end": 94.5
    },
    {
      "id": "a2_bakery_b007_line",
      "beatId": "a2_bakery_b007",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "PROPRIETARIO",
      "text": "Per quanto?",
      "emotion": "neutral",
      "start": 94.5,
      "end": 96.9
    },
    {
      "id": "a2_bakery_b008_line",
      "beatId": "a2_bakery_b008",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "ETIENNE",
      "text": "Abbastanza.",
      "emotion": "tired",
      "start": 96.9,
      "end": 99.3
    },
    {
      "id": "a2_bakery_b010_line",
      "beatId": "a2_bakery_b010",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "PROPRIETARIO",
      "text": "Documenti?",
      "emotion": "neutral",
      "start": 100.5,
      "end": 103.1
    },
    {
      "id": "a2_bakery_b013_line",
      "beatId": "a2_bakery_b013",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "PROPRIETARIO",
      "text": "Mi dispiace.",
      "emotion": "confused",
      "start": 107.1,
      "end": 109.9
    },
    {
      "id": "a2_bakery_b014_line",
      "beatId": "a2_bakery_b014",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "ETIENNE",
      "text": "Non ancora.",
      "emotion": "wry",
      "start": 109.9,
      "end": 112.1
    },
    {
      "id": "a2_bakery_b015_line",
      "beatId": "a2_bakery_b015",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "PROPRIETARIO",
      "text": "Come?",
      "emotion": "confused",
      "start": 112.1,
      "end": 113.9
    },
    {
      "id": "a2_bakery_b016_line",
      "beatId": "a2_bakery_b016",
      "actId": "act2",
      "sceneId": "a2_bakery",
      "shot": "b_two",
      "speaker": "ETIENNE",
      "text": "Non le ho ancora chiesto niente.",
      "emotion": "wry",
      "start": 113.9,
      "end": 117.9
    },
    {
      "id": "a2_office_b002_line",
      "beatId": "a2_office_b002",
      "actId": "act2",
      "sceneId": "a2_office",
      "shot": "j_ots",
      "speaker": "IMPIEGATO",
      "text": "Un indirizzo stabile.",
      "emotion": "neutral",
      "start": 128.4,
      "end": 131.4
    },
    {
      "id": "a2_office_b004_line",
      "beatId": "a2_office_b004",
      "actId": "act2",
      "sceneId": "a2_office",
      "shot": "j_ots",
      "speaker": "ETIENNE",
      "text": "Non ce l'ho.",
      "emotion": "tired",
      "start": 132.9,
      "end": 134.9
    },
    {
      "id": "a2_office_b006_line",
      "beatId": "a2_office_b006",
      "actId": "act2",
      "sceneId": "a2_office",
      "shot": "j_ots",
      "speaker": "IMPIEGATO",
      "text": "Senza indirizzo non possiamo.",
      "emotion": "neutral",
      "start": 135.9,
      "end": 139.5
    },
    {
      "id": "a2_belleville_b004_line",
      "beatId": "a2_belleville_b004",
      "actId": "act2",
      "sceneId": "a2_belleville",
      "shot": "s_market",
      "speaker": "PASSANTE",
      "text": "Scusa.",
      "emotion": "neutral",
      "start": 160,
      "end": 161.6
    },
    {
      "id": "a3_gare_b003_line",
      "beatId": "a3_gare_b003",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_bench",
      "speaker": "MINA",
      "text": "Scusi.",
      "emotion": "afraid",
      "start": 187.6,
      "end": 189.8
    },
    {
      "id": "a3_gare_b005_line",
      "beatId": "a3_gare_b005",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_ots_e",
      "speaker": "ETIENNE",
      "text": "Sì?",
      "emotion": "neutral",
      "start": 190.6,
      "end": 192.2
    },
    {
      "id": "a3_gare_b006_line",
      "beatId": "a3_gare_b006",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_bench",
      "speaker": "MINA",
      "text": "Lei sa leggere una cartina?",
      "emotion": "neutral",
      "start": 192.2,
      "end": 195.6
    },
    {
      "id": "a3_gare_b007_line",
      "beatId": "a3_gare_b007",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_ots_e",
      "speaker": "ETIENNE",
      "text": "Più o meno.",
      "emotion": "confused",
      "start": 195.6,
      "end": 198
    },
    {
      "id": "a3_gare_b008_line",
      "beatId": "a3_gare_b008",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_bench",
      "speaker": "MINA",
      "text": "È un bene.",
      "emotion": "neutral",
      "start": 198,
      "end": 200
    },
    {
      "id": "a3_gare_b009_line",
      "beatId": "a3_gare_b009",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_ots_e",
      "speaker": "ETIENNE",
      "text": "Perché?",
      "emotion": "confused",
      "start": 200,
      "end": 201.6
    },
    {
      "id": "a3_gare_b010_line",
      "beatId": "a3_gare_b010",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_bench",
      "speaker": "MINA",
      "text": "Perché io non so dove sono.",
      "emotion": "sad",
      "start": 201.6,
      "end": 205.2
    },
    {
      "id": "a3_gare_b014_line",
      "beatId": "a3_gare_b014",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two",
      "speaker": "MINA",
      "text": "Mia madre lavora di notte. Non è tornata.",
      "emotion": "sad",
      "start": 211.2,
      "end": 215.4
    },
    {
      "id": "a3_gare_b016_line",
      "beatId": "a3_gare_b016",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two",
      "speaker": "MINA",
      "text": "Una signora ha chiamato. Dice che è in ospedale.",
      "emotion": "afraid",
      "start": 216.6,
      "end": 221.2
    },
    {
      "id": "a3_gare_b017_line",
      "beatId": "a3_gare_b017",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two",
      "speaker": "ETIENNE",
      "text": "Quale ospedale?",
      "emotion": "neutral",
      "start": 221.2,
      "end": 223.4
    },
    {
      "id": "a3_gare_b018_line",
      "beatId": "a3_gare_b018",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two",
      "speaker": "MINA",
      "text": "Non lo so. Ho solo questo.",
      "emotion": "sad",
      "start": 223.4,
      "end": 226.6
    },
    {
      "id": "a3_gare_b020_line",
      "beatId": "a3_gare_b020",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_close_m",
      "speaker": "ETIENNE",
      "text": "Saint-Louis. È scritto qui.",
      "emotion": "neutral",
      "start": 228.6,
      "end": 232.4
    },
    {
      "id": "a3_gare_b021_line",
      "beatId": "a3_gare_b021",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_close_m",
      "speaker": "MINA",
      "text": "Ci sono stata. Non mi hanno lasciata entrare.",
      "emotion": "sad",
      "start": 232.4,
      "end": 236.8
    },
    {
      "id": "a3_gare_b023_line",
      "beatId": "a3_gare_b023",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two2",
      "speaker": "ETIENNE",
      "text": "Chi ti ha dato il foglio?",
      "emotion": "neutral",
      "start": 238.8,
      "end": 241.8
    },
    {
      "id": "a3_gare_b024_line",
      "beatId": "a3_gare_b024",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two2",
      "speaker": "MINA",
      "text": "Madame Rose. La lavanderia.",
      "emotion": "neutral",
      "start": 241.8,
      "end": 245
    },
    {
      "id": "a3_gare_b026_line",
      "beatId": "a3_gare_b026",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two2",
      "speaker": "MINA",
      "text": "Posso farle sentire una cosa?",
      "emotion": "hopeful",
      "start": 247,
      "end": 250.4
    },
    {
      "id": "a3_gare_b029_line",
      "beatId": "a3_gare_b029",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_tape",
      "speaker": "AICHA_TAPE",
      "text": "Mina, amore mio.",
      "emotion": "tender",
      "start": 253.6,
      "end": 256.6
    },
    {
      "id": "a3_gare_b030_line",
      "beatId": "a3_gare_b030",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_tape",
      "speaker": "AICHA_TAPE",
      "text": "Se ascolti questo messaggio, sono ancora al lavoro.",
      "emotion": "tender",
      "start": 256.6,
      "end": 262
    },
    {
      "id": "a3_gare_b031_line",
      "beatId": "a3_gare_b031",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_tape",
      "speaker": "AICHA_TAPE",
      "text": "Non preoccuparti.",
      "emotion": "tender",
      "start": 262,
      "end": 264.6
    },
    {
      "id": "a3_gare_b032_line",
      "beatId": "a3_gare_b032",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_tape",
      "speaker": "AICHA_TAPE",
      "text": "Domani facciamo colazione insieme.",
      "emotion": "tender",
      "start": 264.6,
      "end": 269
    },
    {
      "id": "a3_gare_b035_line",
      "beatId": "a3_gare_b035",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_close_m",
      "speaker": "MINA",
      "text": "Mi aveva promesso le crêpes.",
      "emotion": "sad",
      "start": 274.5,
      "end": 278.1
    },
    {
      "id": "a3_gare_b037_line",
      "beatId": "a3_gare_b037",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two2",
      "speaker": "ETIENNE",
      "text": "Allora andiamo a prenderle.",
      "emotion": "tender",
      "start": 280.6,
      "end": 284
    },
    {
      "id": "a3_gare_b038_line",
      "beatId": "a3_gare_b038",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two2",
      "speaker": "MINA",
      "text": "Dove?",
      "emotion": "surprised",
      "start": 284,
      "end": 285.8
    },
    {
      "id": "a3_gare_b039_line",
      "beatId": "a3_gare_b039",
      "actId": "act3",
      "sceneId": "a3_gare",
      "shot": "g_two2",
      "speaker": "ETIENNE",
      "text": "Da tua madre.",
      "emotion": "tender",
      "start": 285.8,
      "end": 288.4
    },
    {
      "id": "a4_phone_b002_line",
      "beatId": "a4_phone_b002",
      "actId": "act4",
      "sceneId": "a4_phone",
      "shot": "ph_wide",
      "speaker": "ETIENNE",
      "text": "Provo ancora.",
      "emotion": "tired",
      "start": 307.9,
      "end": 310.3
    },
    {
      "id": "a4_phone_b005_line",
      "beatId": "a4_phone_b005",
      "actId": "act4",
      "sceneId": "a4_phone",
      "shot": "ph_close",
      "speaker": "ETIENNE",
      "text": "Niente.",
      "emotion": "sad",
      "start": 314.8,
      "end": 316.8
    },
    {
      "id": "a4_phone_b006_line",
      "beatId": "a4_phone_b006",
      "actId": "act4",
      "sceneId": "a4_phone",
      "shot": "ph_two",
      "speaker": "MINA",
      "text": "Magari è occupato.",
      "emotion": "hopeful",
      "start": 316.8,
      "end": 319.6
    },
    {
      "id": "a4_phone_b007_line",
      "beatId": "a4_phone_b007",
      "actId": "act4",
      "sceneId": "a4_phone",
      "shot": "ph_two",
      "speaker": "ETIENNE",
      "text": "Magari.",
      "emotion": "wry",
      "start": 319.6,
      "end": 321.6
    },
    {
      "id": "a4_phone_b009_line",
      "beatId": "a4_phone_b009",
      "actId": "act4",
      "sceneId": "a4_phone",
      "shot": "ph_two",
      "speaker": "MINA",
      "text": "Lei è mai stato in prigione?",
      "emotion": "neutral",
      "start": 324.6,
      "end": 328.2
    },
    {
      "id": "a4_phone_b011_line",
      "beatId": "a4_phone_b011",
      "actId": "act4",
      "sceneId": "a4_phone",
      "shot": "ph_close",
      "speaker": "ETIENNE",
      "text": "Sì.",
      "emotion": "tired",
      "start": 330.7,
      "end": 332.5
    },
    {
      "id": "a4_phone_b012_line",
      "beatId": "a4_phone_b012",
      "actId": "act4",
      "sceneId": "a4_phone",
      "shot": "ph_two",
      "speaker": "MINA",
      "text": "E com'era?",
      "emotion": "neutral",
      "start": 332.5,
      "end": 334.7
    },
    {
      "id": "a4_phone_b013_line",
      "beatId": "a4_phone_b013",
      "actId": "act4",
