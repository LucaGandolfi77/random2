{
  "name": "borgo-pwa",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "BORGO SAN DONNINO — La Passeggiata: an open-world golden-hour walk through Fidenza with cars, bicycles, a station train and free flight, built with Three.js.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
