{
  "name": "hype-ko-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HYPE K.O. - THE LAST VIRALITY. A 3D browser fighting game.",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.35.0",
    "@babylonjs/serializers": "9.35.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "babylonjs-gltf2interface": "9.35.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
