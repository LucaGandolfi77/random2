# HYPE K.O. configuration
# The game is fully playable offline with local storage. These values are optional.

# WebSocket game server URL. Leave empty to auto-detect:
# - dev (Vite on 5173): ws://localhost:8787
# - production: same origin as the page
# VITE_WS_URL=ws://localhost:8787

# Port used by the bundled Node game server.
PORT=8787

