    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
