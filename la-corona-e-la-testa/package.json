{
  "name": "la-corona-e-la-testa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "La Corona e la Testa — cortometraggio animato low-poly per browser",
  "scripts": {
    "captions": "tsx scripts/export-captions.ts",
    "predev": "npm run captions",
    "dev": "vite",
